<UserControl x:Class="LeafNeko.DeployTool.Controls.AppCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236" Height="180"
             Cursor="Hand" Opacity="0"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" Color="#1A000000"
                          BlurRadius="8" ShadowDepth="2" Opacity="0.3" Direction="315"/>

        <!-- 边角弧度渐变扩散画刷：从左上角辐射到全局 -->
        <RadialGradientBrush x:Key="CornerGlowBrush"
                             GradientOrigin="0,0" Center="0,0"
                             RadiusX="1.5" RadiusY="1.5">
            <GradientStop Color="#30F8A5B2" Offset="0"/>
            <GradientStop Color="#15FFB6C1" Offset="0.4"/>
            <GradientStop Color="#00FFFFFF" Offset="0.8"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <!-- 缩放变换容器 -->
        <Grid Name="ScaleContainer" RenderTransformOrigin="0.5,0.5" MouseEnter="OnMouseEnter">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- 主卡片 -->
            <Border Name="MainBorder" CornerRadius="12"
                    Effect="{DynamicResource CardShadow}"
                    RenderTransformOrigin="0.5,0.5"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardAccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 图标 -->
                    <Border Grid.Row="0" Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource CardAccentBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated"
                                   RenderOptions.ClearTypeHint="Enabled"/>
                    </Border>

                    <!-- 软件名 -->
                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextHintingMode="Animated"
                               RenderOptions.ClearTypeHint="Enabled"/>

                    <!-- 分类标签 -->
                    <Border Grid.Row="2" CornerRadius="10"
                            Background="{DynamicResource CardAccentBrush}" Padding="8,2"
                            HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextOptions.TextHintingMode="Animated"
                                   RenderOptions.ClearTypeHint="Enabled"/>
                    </Border>

                    <!-- ETA 显示 -->
                    <TextBlock Grid.Row="3" Text="{Binding EtaText}"
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Visibility="{Binding EtaText, Converter={StaticResource StringToVisibilityConverter}}"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextHintingMode="Animated"
                               RenderOptions.ClearTypeHint="Enabled"/>

                    <!-- 状态 + 勾选 -->
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="4,0,0,0"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"
                                       TextOptions.TextHintingMode="Animated"
                                       RenderOptions.ClearTypeHint="Enabled"/>
                            <!-- 更新可用指示 -->
                            <Ellipse Width="7" Height="7" Fill="#FF9800"
                                     Margin="6,0,0,0"
                                     Visibility="{Binding HasUpdateIndicator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="有更新"
                                       FontSize="10" Foreground="#FF9800"
                                       Margin="2,0,0,0"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"
                                       TextOptions.TextHintingMode="Animated"
                                       RenderOptions.ClearTypeHint="Enabled"
                                       Visibility="{Binding HasUpdateIndicator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 边角弧度渐变扩散叠加层 -->
            <Border Name="GlowOverlay" CornerRadius="12"
                    Background="{DynamicResource CornerGlowBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"/>

            <!-- 右上角半圆重试按钮（位于 ScaleContainer 内，跟随卡片变形） -->
            <Button Content="↻"
                    FontSize="16" FontWeight="Bold"
                    Foreground="#FFFFFF"
                    Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Cursor="Hand"
                    Panel.ZIndex="10"
                    Click="RetryBtn_Click"
                    ToolTip="重试安装"
                    Visibility="{Binding IsRetryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="RetryBg" CornerRadius="18"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RetryBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RetryBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RetryBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RetryBg"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
