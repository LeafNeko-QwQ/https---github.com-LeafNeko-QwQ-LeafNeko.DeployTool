<Window x:Class="LeafNeko.DeployTool.Views.ConfirmDeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📦 便携应用部署确认"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border CornerRadius="16" Background="White" BorderBrush="#F8A5B2" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖拽） -->
            <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Hand"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="便携应用部署确认"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#3D3D3D"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 更新日期 -->
            <TextBlock Grid.Row="1" Text="{Binding DateText}"
                       FontSize="13" Foreground="#9E9E9E"
                       Margin="0,0,0,10"/>

            <!-- 更新内容标题 -->
            <TextBlock Grid.Row="2" Text="📋 更新内容"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#3D3D3D"
                       Margin="0,0,0,6"/>

            <!-- 更新日志（可滚动） -->
            <Border Grid.Row="3" CornerRadius="8" Background="#FFF5F7"
                    Padding="12" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                    <TextBlock Text="{Binding UpdateLog}"
                               FontSize="12" Foreground="#666666"
                               TextWrapping="Wrap" LineHeight="20"/>
                </ScrollViewer>
            </Border>

            <!-- 部署内容标题 -->
            <TextBlock Grid.Row="4" Text="{Binding LinkCountText}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#3D3D3D"
                       Margin="0,0,0,6"/>

            <!-- 直链列表（可滚动） -->
            <Border Grid.Row="5" CornerRadius="8" Background="#FFF5F7"
                    Padding="12" Margin="0,0,0,16" MaxHeight="100">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="11" Foreground="#9E9E9E"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 按钮 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="取消"
                        Width="120" Height="40"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="✅ 确认部署"
                        Width="140" Height="40"
                        FontSize="14"
                        Foreground="White"
                        Background="#F8A5B2"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="16,0,0,0"
                        Click="ConfirmBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
