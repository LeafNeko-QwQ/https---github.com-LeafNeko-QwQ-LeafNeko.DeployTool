<Window x:Class="LeafNeko.DeployTool.Views.DeployProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LeafNeko.DeployTool.Converters"
        Title="🚀 一键部署全部"
        Icon="/Resources/logo.png"
        Width="580" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.Resources>
        <conv:ProgressToVisibilityConverter x:Key="ProgressToVisibilityConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖拽） -->
            <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Hand"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="一键部署全部"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 总进度 -->
            <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource CardAccentBrush}"
                    Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📊 总进度"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding OverallProgressText}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Height="8"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding OverallProgress}"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource BorderLightBrush}"
                                 BorderThickness="0"
                                 Margin="0,0,0,6"
                                 Style="{DynamicResource ShimmerProgressBar}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding ElapsedText}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding EtaText}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="16,0,0,0"
                                   Visibility="{Binding EtaText, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                    Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 任务名称 + 状态 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border CornerRadius="10" Padding="6,2" Margin="8,0,0,0"
                                                Background="{DynamicResource CardAccentBrush}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 阶段文字 -->
                                    <TextBlock Text="{Binding PhaseText}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding PhaseText, Converter={StaticResource StringToVisibilityConverter}}"/>

                                    <!-- 总进度 -->
                                    <StackPanel Visibility="{Binding OverallProgress, Converter={StaticResource ProgressToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="总进度" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:F0}%}"
                                                       FontSize="10" Foreground="{DynamicResource PrimaryBrush}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Height="5"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding OverallProgress}"
                                                     Foreground="{DynamicResource PrimaryBrush}"
                                                     Background="{DynamicResource BorderLightBrush}"
                                                     BorderThickness="0"
                                                     Margin="0,0,0,6"
                                                     Style="{DynamicResource ShimmerProgressBar}"/>
                                    </StackPanel>

                                    <!-- 下载进度 -->
                                    <StackPanel Visibility="{Binding DownloadProgress, Converter={StaticResource ProgressToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="下载" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                                                       FontSize="10" Foreground="{DynamicResource PrimaryDarkBrush}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Height="4"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding DownloadProgress}"
                                                     Foreground="{DynamicResource PrimaryDarkBrush}"
                                                     Background="{DynamicResource BorderLightBrush}"
                                                     BorderThickness="0"
                                                     Margin="0,0,0,6"
                                                     Style="{DynamicResource ShimmerProgressBar}"/>
                                    </StackPanel>

                                    <!-- 解压进度 -->
                                    <StackPanel Visibility="{Binding ExtractProgress, Converter={StaticResource ProgressToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="解压" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ExtractProgress, StringFormat={}{0:F0}%}"
                                                       FontSize="10" Foreground="{DynamicResource PrimaryLightBrush}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ProgressBar Height="4"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ExtractProgress}"
                                                     Foreground="{DynamicResource PrimaryLightBrush}"
                                                     Background="{DynamicResource BorderLightBrush}"
                                                     BorderThickness="0"
                                                     Margin="0,0,0,4"
                                                     Style="{DynamicResource ShimmerProgressBar}"/>
                                    </StackPanel>

                                    <!-- 速度 -->
                                    <TextBlock Text="{Binding SpeedText}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding SpeedText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 取消按钮 -->
            <Button Grid.Row="3" x:Name="CancelBtn" Content="取消全部"
                    Width="140" Height="40"
                    FontSize="14"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CancelBtn_Click"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
