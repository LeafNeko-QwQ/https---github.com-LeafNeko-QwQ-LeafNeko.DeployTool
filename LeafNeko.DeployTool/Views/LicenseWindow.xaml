<Window x:Class="LeafNeko.DeployTool.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LeafNeko 装机助手 - 许可协议"
        Width="600" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="LeafNeko 装机助手"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- 许可内容 -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LicenseTextBlock"
                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                               LineHeight="22"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="AgreeButton"
                        Content=" 同 意 "
                        Width="140" Height="40"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="White"
                        Cursor="Hand"
                        Click="AgreeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="8"
                                    Name="border">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="DisagreeButton"
                        Content="不同意"
                        Width="140" Height="40"
                        Margin="16,0,0,0"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Cursor="Hand"
                        Click="DisagreeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                    Name="border">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CardAccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
